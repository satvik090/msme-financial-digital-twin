{
  "name": "msme-financial-digital-twin-api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "type": "module",
  "description": "Backend foundation for the MSME Financial Digital Twin",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "ml:install": "python -m pip install -r ml-service/requirements.txt",
    "ml:train": "cd ml-service && python -m app.train",
    "ml:dev": "cd ml-service && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}